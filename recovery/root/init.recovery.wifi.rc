on property:twrp.variant.files_copied=1
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1
    write /dev/kmsg "[peridotwifi][trigger] starting cp-wifi-ko"
    start cp-wifi-ko

on property:twrp.cpko=true
    wait /vendor/lib/modules/cnss_prealloc.ko
    insmod /vendor/lib/modules/cnss_prealloc.ko
    wait /vendor/lib/modules/cnss_nl.ko
    insmod /vendor/lib/modules/cnss_nl.ko
    wait /vendor/lib/modules/wlan_firmware_service.ko
    insmod /vendor/lib/modules/wlan_firmware_service.ko
    wait /vendor/lib/modules/cnss_plat_ipc_qmi_svc.ko
    insmod /vendor/lib/modules/cnss_plat_ipc_qmi_svc.ko
    wait /vendor/lib/modules/cnss_utils.ko
    insmod /vendor/lib/modules/cnss_utils.ko
    wait /vendor/lib/modules/cnss2.ko
    insmod /vendor/lib/modules/cnss2.ko
    wait /vendor/lib/modules/icnss2.ko
    insmod /vendor/lib/modules/icnss2.ko
    wait /vendor/lib/modules/rmnet_wlan.ko
    insmod /vendor/lib/modules/rmnet_wlan.ko
    wait /vendor/lib/modules/cfg80211.ko
    insmod /vendor/lib/modules/cfg80211.ko
    wait /vendor/lib/modules/xiaomi_wifi_gpio.ko
    insmod /vendor/lib/modules/xiaomi_wifi_gpio.ko
    write /dev/kmsg "[peridotwifi][modules] wifi modules loaded"
    setprop twrp.insmodko 1

on init
    write /dev/kmsg "[peridotwifi][init] preparing wifi paths"

    symlink /system/etc/firmware /etc/firmware

    mkdir /vendor/firmware 0777 root shell
    mkdir /vendor/firmware/wlan 0777 root shell
    mkdir /vendor/firmware/wlan/qca_cld 0777 root shell
    mkdir /vendor/firmware/wlan/qca_cld/qca6750 0777 root shell
    mkdir /vendor/firmware/wlan/qca_cld/kiwi_v2 0777 root shell

    symlink /vendor/etc/wifi/qca6750/WCNSS_qcom_cfg.ini /vendor/firmware/wlan/qca_cld/qca6750/WCNSS_qcom_cfg.ini
    symlink /vendor/etc/wifi/kiwi_v2/WCNSS_qcom_cfg.ini /vendor/firmware/wlan/qca_cld/kiwi_v2/WCNSS_qcom_cfg.ini
    symlink /vendor/etc/wifi/qca6750/wlan_mac.bin /vendor/firmware/wlan/qca_cld/qca6750/wlan_mac.bin
    symlink /vendor/etc/wifi/kiwi_v2/wlan_mac.bin /vendor/firmware/wlan/qca_cld/kiwi_v2/wlan_mac.bin

    mkdir /data/misc 0777 root shell
    mkdir /data/misc/wifi 0777 root shell
    mkdir /tmp/recovery 0777 root root
    mkdir /tmp/recovery/sockets 0777 root root

    write /dev/kmsg "[peridotwifi][init] wifi paths ready"

on boot
    write /dev/kmsg "[peridotwifi][boot] setting wifi boot environment"
    write /sys/kernel/cnss/recovery 3
    chown radio wakelock /sys/power/wake_lock
    chown radio wakelock /sys/power/wake_unlock
    chmod 0660 /sys/power/wake_lock
    chmod 0660 /sys/power/wake_unlock
    write /dev/kmsg "[peridotwifi][boot] wifi boot environment set"

service vendor.qrtr-ns /vendor/bin/qrtr-ns -f
    disabled
    user root
    group root
    capabilities NET_BIND_SERVICE
    seclabel u:r:recovery:s0

service vendor.rmt_storage /vendor/bin/rmt_storage
    disabled
    user root
    ioprio rt 0
    seclabel u:r:recovery:s0

service cnss-daemon /vendor/bin/cnss-daemon -n -l
    disabled
    user root
    group root system inet net_admin wifi
    capabilities NET_ADMIN
    seclabel u:r:recovery:s0

service wpa_supplicant /vendor/bin/wpa_supplicant -Dnl80211 -iwlan0 -dd -O/tmp/recovery/sockets -c/vendor/etc/wifi/wpa_supplicant.conf
    disabled
    user root
    group root wifi inet net_admin net_raw
    capabilities NET_ADMIN NET_RAW
    seclabel u:r:recovery:s0

service dhcpcd /system/bin/dhcpcd wlan0 -B
    disabled
    oneshot
    user root
    group root inet net_admin net_raw
    seclabel u:r:recovery:s0

service cp-wifi-ko /system/bin/cp-wifi-ko.sh
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0

on property:survival.start.service=true
    write /dev/kmsg "[peridotwifi][service] starting qualcomm helpers"
    start vendor.qrtr-ns
    start vendor.rmt_storage
    write /dev/kmsg "[peridotwifi][service] qualcomm helpers started"

on early-boot
    write /sys/kernel/icnss/wlan_en_delay 1000
    write /dev/kmsg "[peridotwifi][early-boot] wlan_en_delay set to 1000"
    write /sys/kernel/icnss/wpss_boot 1
    write /dev/kmsg "[peridotwifi][early-boot] wpss_boot set to 1"

on property:qcomwlan.driver.load=true
    write /dev/kmsg "[peridotwifi][driver] waiting for wlan0"
    wait /sys/class/net/wlan0 10
    write /dev/kmsg "[peridotwifi][driver] wlan0 detected"
    setprop peridotwifi.driver.ready true

on property:twrp.insmodko=1
    setprop survival.start.service true
    setprop qcomwlan.driver.load true

on property:peridotwifi.driver.ready=true
    write /dev/kmsg "[peridotwifi][supplicant] starting wpa_supplicant"
    start wpa_supplicant

on property:init.svc.wpa_supplicant=running
    write /dev/kmsg "[peridotwifi][dhcp] starting dhcpcd"
    start dhcpcd

on property:init.svc.wpa_supplicant=stopped
    stop dhcpcd
    write /dev/kmsg "[peridotwifi][supplicant] wpa_supplicant stopped"
