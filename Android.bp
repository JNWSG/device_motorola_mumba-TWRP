soong_namespace {
    imports: ["hardware/qcom-caf/bootctrl"],
}

// Prebuilt shared libraries needed by android.hardware.boot-service.qti.recovery
// via libboot_control_qti.so → librecovery_updater.so
// Cannot use PRODUCT_COPY_FILES for ELF files; use cc_prebuilt_library_shared instead.

cc_prebuilt_library_shared {
    name: "librecovery_updater",
    srcs: ["recovery/root/vendor/lib64/librecovery_updater.so"],
    strip: { none: true },
    check_elf_files: false,
    prefer: true,
    recovery_available: true,
}

cc_prebuilt_library_shared {
    name: "librecovery_updater_msm",
    srcs: ["recovery/root/vendor/lib64/librecovery_updater_msm.so"],
    strip: { none: true },
    check_elf_files: false,
    prefer: true,
    recovery_available: true,
}
